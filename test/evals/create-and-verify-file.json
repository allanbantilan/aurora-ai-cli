{
  "name": "create-and-verify-file",
  "prompt": "Create hello.txt containing hello world and verify it.",
  "responses": [
    {
      "tool": "write_file",
      "args": { "path": "hello.txt", "content": "hello world\n" }
    },
    {
      "tool": "read_file",
      "args": { "path": "hello.txt" }
    },
    {
      "content": "Done: created and verified hello.txt."
    }
  ],
  "expect": {
    "tools": ["write_file", "read_file"],
    "files": [
      { "path": "hello.txt", "contains": "hello world" }
    ],
    "verification": { "after": "write_file", "tool": "read_file" },
    "contains": ["verified"],
    "forbid": ["already existed"]
  }
}
